{
	"name": "blogfolio",
	"version": "0.0.1",
	"private": true,
	"license": "MIT-Modern-Variant",
	"author": "Lucas Vienna <dev@lucasvienna.dev> (https://lucasvienna.dev)",
	"repository": {
		"type": "git",
		"url": "https://github.com/lucasvienna/blogfolio.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"test:ci": "vitest run --coverage",
		"test:e2e": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint --type-aware --fix --fix-suggestions && eslint --fix .",
		"lint:ci": "prettier --check . && eslint .",
		"format": "prettier --write --list-different .",
		"prepare": "pnpm exec playwright install",
		"postinstall": "svelte-kit sync"
	},
	"dependencies": {
		"@fontsource/fira-mono": "^5.3.0",
		"@lucide/svelte": "^1.0.1",
		"@picocss/pico": "^2.1.1",
		"rehype-callouts": "^2.2.0",
		"rehype-slug": "^6.0.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-toc": "^9.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@neoconfetti/svelte": "^2.2.2",
		"@playwright/test": "^1.62.1",
		"@prettier/plugin-oxc": "^0.2.2",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.1.2",
		"@vitest/coverage-v8": "4.1.10",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-oxlint": "^1.76.0",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"mdsvex": "^0.12.8",
		"oxlint": "^1.76.0",
		"oxlint-tsgolint": "^7.0.2001",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": "^24.15.0 || ^26",
		"pnpm": "^11.0.0"
	}
}
