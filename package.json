{
	"name": "blogfolio",
	"version": "0.0.1",
	"private": true,
	"license": "MIT-Modern-Variant",
	"author": "Lucas Vienna <dev@lucasvienna.dev> (https://lucasvienna.dev)",
	"repository": {
		"type": "git",
		"url": "https://github.com/lucasvienna/blogfolio.git"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"test:ci": "vitest run --coverage",
		"test:e2e": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint --fix --fix-suggestions && eslint --fix .",
		"lint:ci": "oxlint && eslint .",
		"fmt": "oxfmt",
		"fmt:ci": "oxfmt --check",
		"prepare": "pnpm exec playwright install",
		"postinstall": "svelte-kit sync"
	},
	"dependencies": {
		"@fontsource/fira-mono": "^5.3.0",
		"@lucide/svelte": "^1.65.0",
		"@picocss/pico": "^2.1.1",
		"rehype-callouts": "^2.2.0",
		"rehype-slug": "^6.0.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-toc": "^9.0.0"
	},
	"devDependencies": {
		"@neoconfetti/svelte": "^2.2.2",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "5.1.0",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.24.1",
		"jiti": "^2.7.0",
		"mdsvex": "^0.12.8",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2006",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tslib": "^2.9.1",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.7",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": "^24.15.0 || ^26",
		"pnpm": "^11.0.0"
	}
}
