{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": false,
	"printWidth": 100,
	"trailingComma": "none",
	"proseWrap": "always",
	"sortImports": true,
	"sortPackageJson": true,
	"svelte": true,
	"ignorePatterns": [
		".DS_Store",
		"node_modules",
		"/.claude",
		"/skills-lock.json",
		"/build",
		"/.svelte-kit",
		"/.vscode",
		"/package",
		"/coverage",
		".env",
		".env.*",
		"!.env.example",
		"pnpm-lock.yaml",
		"package-lock.json",
		"yarn.lock"
	]
}
